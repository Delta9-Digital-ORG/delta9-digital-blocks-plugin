{
	"$schema": "https://raw.githubusercontent.com/infinum/eightshift-frontend-libs/develop/schemas/block.json",
	"blockName": "price-card",
	"title": "Price Card",
	"description": "A pricing card in a Badge Cards grid: package (eyebrow, price, feature list, button) or retainer (price, name, description). Same notched shell as the Badge Card.",
	"category": "eightshift",
	"icon": {
		"src": "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><rect x='3.75' y='3.75' width='16.5' height='16.5' rx='2.5' stroke='currentColor' stroke-width='1.5'/><path d='M12 7v10M14.5 9.2c-.5-.8-1.4-1.2-2.5-1.2-1.4 0-2.5.8-2.5 1.9 0 2.6 5 1.4 5 4.1 0 1.1-1.1 2-2.5 2-1.2 0-2.2-.5-2.6-1.4' stroke='currentColor' stroke-width='1.3' stroke-linecap='round'/></svg>"
	},
	"keywords": [
		"price",
		"pricing",
		"package",
		"plan",
		"retainer"
	],
	"parent": [
		"eightshift-boilerplate/badge-cards"
	],
	"hasInnerBlocks": false,
	"attributes": {
		"priceCardEyebrow": {
			"type": "string",
			"default": ""
		},
		"priceCardPrice": {
			"type": "string",
			"default": "$0"
		},
		"priceCardSuffix": {
			"type": "string",
			"default": ""
		},
		"priceCardHighlight": {
			"type": "boolean",
			"default": false
		},
		"priceCardName": {
			"type": "string",
			"default": ""
		},
		"priceCardBody": {
			"type": "string",
			"default": ""
		},
		"priceCardFeatures": {
			"type": "string",
			"default": ""
		},
		"priceCardLinkLabel": {
			"type": "string",
			"default": ""
		},
		"priceCardLinkUrl": {
			"type": "string",
			"default": ""
		},
		"priceCardLinkStyle": {
			"type": "string",
			"default": "outline"
		},
		"priceCardAccent": {
			"type": "string",
			"default": ""
		},
		"priceCardServerSideRender": {
			"type": "boolean",
			"default": false
		},
		"wrapperUse": {
			"type": "boolean",
			"default": false
		},
		"wrapperNoControls": {
			"type": "boolean",
			"default": true
		}
	},
	"options": {
		"priceCardLinkStyle": [
			{ "label": "Filled (mint)", "value": "fill" },
			{ "label": "Outline", "value": "outline" }
		],
		"priceCardAccent": [
			{ "label": "From the grid position", "value": "" },
			{ "label": "Mint", "value": "mint" },
			{ "label": "Coral", "value": "coral" },
			{ "label": "Cyan", "value": "cyan" },
			{ "label": "Yellow", "value": "yellow" }
		]
	}
}
