{
	"$schema": "https://raw.githubusercontent.com/infinum/eightshift-frontend-libs/develop/schemas/block.json",
	"blockName": "carousel-item",
	"title": "Carousel item",
	"description": "A carousel item: an image, or any blocks as a content slide.",
	"category": "eightshift",
	"icon": {
		"src": "es-image"
	},
	"keywords": [
		"carousel",
		"item"
	],
	"components": {
		"image": "image"
	},
	"attributes": {
		"wrapperUse": {
			"type": "boolean",
			"default": false
		},
		"wrapperNoControls": {
			"type": "boolean",
			"default": true
		},
		"carouselItemUseContent": {
			"type": "boolean",
			"default": false
		}
	},
	"parent": [
		"eightshift-boilerplate/carousel"
	],
	"hasInnerBlocks": true
}
