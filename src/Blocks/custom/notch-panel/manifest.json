{
	"$schema": "https://raw.githubusercontent.com/infinum/eightshift-frontend-libs/develop/schemas/block.json",
	"blockName": "notch-panel",
	"title": "Notch Panel",
	"description": "Raised panel with a notch cut from one top corner and a pill eyebrow in the notch. Holds core content.",
	"category": "eightshift",
	"icon": {
		"src": "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M3 9.5V19a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-7.5v3.5a3 3 0 0 1-3 3H3Z' stroke='currentColor' stroke-width='1.6' stroke-linejoin='round'/><rect x='3' y='3' width='6' height='3.5' rx='1.75' stroke='currentColor' stroke-width='1.4'/></svg>"
	},
	"keywords": [
		"notch",
		"panel",
		"section",
		"pill"
	],
	"supports": {
		"align": ["wide", "full"],
		"anchor": true
	},
	"example": {
		"attributes": {
			"notchPanelPillText": "What we do"
		},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"content": "Four disciplines, one team"
				}
			}
		]
	},
	"hasInnerBlocks": true,
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		},
		"notchPanelPillText": {
			"type": "string",
			"default": ""
		},
		"notchPanelPillSide": {
			"type": "string",
			"default": "left"
		},
		"notchPanelTone": {
			"type": "string",
			"default": "surface"
		},
		"notchPanelGlow": {
			"type": "boolean",
			"default": false
		},
		"notchPanelAllowedBlocks": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": [
				"core/heading",
				"core/paragraph",
				"core/buttons",
				"core/quote",
				"core/columns",
				"core/image",
				"core/group",
				"eightshift-boilerplate/badge-cards",
				"eightshift-forms/forms"
			]
		},
		"wrapperUse": {
			"type": "boolean",
			"default": false
		},
		"wrapperNoControls": {
			"type": "boolean",
			"default": true
		}
	},
	"options": {
		"notchPanelPillSide": [
			{ "label": "Left", "value": "left" },
			{ "label": "Right", "value": "right" }
		],
		"notchPanelTone": [
			{ "label": "Surface", "value": "surface" },
			{ "label": "Mint", "value": "mint" }
		]
	}
}
