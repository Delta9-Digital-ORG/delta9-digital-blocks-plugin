{
	"$schema": "https://raw.githubusercontent.com/infinum/eightshift-frontend-libs/develop/schemas/block.json",
	"blockName": "feature-rows",
	"title": "Feature Rows",
	"description": "One offering track: tall image on one side; pill eyebrow, heading and three numbered rows in the track's accent on the other.",
	"category": "eightshift",
	"icon": {
		"src": "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><rect x='3' y='4' width='8' height='16' rx='2' stroke='currentColor' stroke-width='1.5'/><path d='M14 7h7M14 12h7M14 17h7' stroke='currentColor' stroke-width='1.5' stroke-linecap='round'/></svg>"
	},
	"keywords": [
		"feature",
		"track",
		"image",
		"offering"
	],
	"hasInnerBlocks": false,
	"attributes": {
		"featureRowsImageId": {
			"type": "integer",
			"default": 0
		},
		"featureRowsImageUrl": {
			"type": "string",
			"default": ""
		},
		"featureRowsImageAlt": {
			"type": "string",
			"default": ""
		},
		"featureRowsImageSide": {
			"type": "string",
			"default": "left"
		},
		"featureRowsAccent": {
			"type": "string",
			"default": "mint"
		},
		"featureRowsEyebrow": {
			"type": "string",
			"default": ""
		},
		"featureRowsHeading": {
			"type": "string",
			"default": "Heading"
		},
		"featureRowsRows": {
			"type": "array",
			"default": []
		},
		"featureRowsServerSideRender": {
			"type": "boolean",
			"default": false
		},
		"wrapperUse": {
			"type": "boolean",
			"default": false
		},
		"wrapperNoControls": {
			"type": "boolean",
			"default": true
		}
	},
	"options": {
		"featureRowsImageSide": [
			{ "label": "Image left", "value": "left" },
			{ "label": "Image right", "value": "right" }
		]
	}
}
