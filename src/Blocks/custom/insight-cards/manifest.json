{
	"$schema": "https://raw.githubusercontent.com/infinum/eightshift-frontend-libs/develop/schemas/block.json",
	"blockName": "insight-cards",
	"title": "Insight Cards",
	"description": "One featured post spanning two columns plus two smaller posts: image cards with author chip, category pill and Read button in notches.",
	"category": "eightshift",
	"icon": {
		"src": "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><rect x='2.75' y='3.75' width='12' height='16.5' rx='2.5' stroke='currentColor' stroke-width='1.5'/><rect x='16.75' y='3.75' width='4.5' height='7.5' rx='1.5' stroke='currentColor' stroke-width='1.5'/><rect x='16.75' y='12.75' width='4.5' height='7.5' rx='1.5' stroke='currentColor' stroke-width='1.5'/><path d='M5.5 15.5h6M5.5 17.5h4' stroke='currentColor' stroke-width='1.5' stroke-linecap='round'/></svg>"
	},
	"keywords": [
		"insights",
		"posts",
		"blog",
		"latest"
	],
	"supports": {
		"align": ["full"],
		"anchor": true
	},
	"hasInnerBlocks": false,
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"insightCardsVariant": {
			"type": "string",
			"default": "featured"
		},
		"insightCardsCategorySlug": {
			"type": "string",
			"default": ""
		},
		"insightCardsQuery": {
			"type": "string",
			"default": "latest"
		},
		"insightCardsFeaturedId": {
			"type": "integer",
			"default": 0
		},
		"insightCardsIds": {
			"type": "array",
			"items": {
				"type": "integer"
			},
			"default": []
		},
		"insightCardsCategory": {
			"type": "integer",
			"default": 0
		},
		"insightCardsFeaturedLabel": {
			"type": "string",
			"default": "Featured insight"
		},
		"insightCardsAccentByCategory": {
			"type": "object",
			"default": {
				"compliance": "mint",
				"design": "coral",
				"seo": "cyan",
				"marketing": "yellow"
			}
		},
		"insightCardsServerSideRender": {
			"type": "boolean",
			"default": false
		},
		"wrapperUse": {
			"type": "boolean",
			"default": false
		},
		"wrapperNoControls": {
			"type": "boolean",
			"default": true
		}
	},
	"options": {
		"insightCardsVariant": [
			{ "label": "Featured + two (home)", "value": "featured" },
			{ "label": "Related: three compact cards", "value": "related" }
		],
		"insightCardsQuery": [
			{ "label": "Latest posts", "value": "latest" },
			{ "label": "Pick posts", "value": "manual" }
		]
	}
}
