{
	"$schema": "https://raw.githubusercontent.com/infinum/eightshift-frontend-libs/develop/schemas/block.json",
	"blockName": "badge-card",
	"title": "Badge Card",
	"description": "One card in a Badge Cards grid: numbered badge, accent title, body and a link or step footer.",
	"category": "eightshift",
	"icon": {
		"src": "<svg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><rect x='3.75' y='6.75' width='16.5' height='13.5' rx='2.5' stroke='currentColor' stroke-width='1.5'/><rect x='14' y='3' width='6' height='6' rx='1.6' stroke='currentColor' stroke-width='1.3'/><path d='M7 12h7M7 15.5h9' stroke='currentColor' stroke-width='1.5' stroke-linecap='round'/></svg>"
	},
	"keywords": [
		"badge",
		"card"
	],
	"parent": [
		"eightshift-boilerplate/badge-cards"
	],
	"hasInnerBlocks": false,
	"attributes": {
		"badgeCardBadge": {
			"type": "string",
			"default": ""
		},
		"badgeCardAccent": {
			"type": "string",
			"default": ""
		},
		"badgeCardTitle": {
			"type": "string",
			"default": ""
		},
		"badgeCardBody": {
			"type": "string",
			"default": ""
		},
		"badgeCardLinkLabel": {
			"type": "string",
			"default": ""
		},
		"badgeCardLinkUrl": {
			"type": "string",
			"default": ""
		},
		"badgeCardStepLabel": {
			"type": "string",
			"default": ""
		},
		"badgeCardWhenLabel": {
			"type": "string",
			"default": ""
		},
		"wrapperUse": {
			"type": "boolean",
			"default": false
		},
		"wrapperNoControls": {
			"type": "boolean",
			"default": true
		}
	},
	"options": {
		"badgeCardAccent": [
			{ "label": "By position", "value": "" },
			{ "label": "Mint", "value": "mint" },
			{ "label": "Coral", "value": "coral" },
			{ "label": "Cyan", "value": "cyan" },
			{ "label": "Yellow", "value": "yellow" },
			{ "label": "Purple", "value": "purple" },
			{ "label": "Light", "value": "light" }
		]
	}
}
