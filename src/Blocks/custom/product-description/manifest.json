{
	"$schema": "https://raw.githubusercontent.com/infinum/eightshift-frontend-libs/develop/schemas/block.json",
	"blockName": "product-description",
	"title": "Product Description",
	"description": "Renders the current product's description and ingredients in a white card with primary-green border. Loop-safe — resolves the product via get_the_ID().",
	"category": "eightshift",
	"icon": {
		"src": "es-card"
	},
	"keywords": [
		"Product",
		"Description",
		"Ingredients"
	],
	"attributes": {
		"productDescriptionHeading": {
			"type": "string",
			"default": "Description"
		},
		"productDescriptionProductId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	}
}
